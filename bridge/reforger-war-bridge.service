[Unit]
Description=Kolguyev war bridge (headquarters orders.tsv, Reforger mod state.tsv)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Replace /path/to/cbpnk-kolguyev with this checkout. The headquarters .env holds REFORGER_BRIDGE_SECRET.
Environment=REFORGER_WAR_ENABLE=1
EnvironmentFile=-/path/to/cbpnk-kolguyev/hq/.env
ExecStart=/path/to/cbpnk-kolguyev/bridge/war-bridge.sh --loop
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
