# Copy to server/.env and set SERVER_PUBLIC_ADDRESS, GAME_PASSWORD_ADMIN, and RCON_PASSWORD.
# Do not commit the live file.
# The war launch (docker-compose.war.yml) ignores GAME_NAME and GAME_SCENARIO_ID.
# It loads Game Master Kolguyev with the packed addon. Join by address and port.

SERVER_PUBLIC_ADDRESS=127.0.0.1
GAME_PORT=2001
A2S_PORT=17777
RCON_PORT=19999

GAME_NAME=Kolguyev
GAME_SCENARIO_ID={F45C6C15D31252E6}Missions/27_GM_Cain.conf
GAME_MODS_IDS_LIST=
GAME_MAX_PLAYERS=8
GAME_VISIBLE=true
ARMA_MAX_FPS=60
OPERATING_AI_LIMIT=192

# Join password. Empty = open server.
GAME_PASSWORD=
# In-game #login. No spaces.
GAME_PASSWORD_ADMIN=changeme
# Localhost RCON only. No spaces, at least 3 characters.
RCON_PASSWORD=changeme
