# Copy to /opt/reforger-server/.env and set the three secrets.
# Do not commit the live file.

SERVER_PUBLIC_ADDRESS=127.0.0.1
GAME_PORT=2001
A2S_PORT=17777
RCON_PORT=19999

GAME_NAME=qpstall
GAME_SCENARIO_ID={3BE30F418DCEE458}Missions/ConflictPVERemixedVanilla2_Cain.conf
# Conflict PvE Remixed (Gramps). Kolguyev: counterattacks, vehicle patrols, artillery.
GAME_MODS_IDS_LIST=61B514B96692C049
GAME_MAX_PLAYERS=8
GAME_VISIBLE=true
ARMA_MAX_FPS=60
OPERATING_AI_LIMIT=192

# Join password shown on /reforger. Empty = open server browser entry.
GAME_PASSWORD=
# In-game #login. No spaces.
GAME_PASSWORD_ADMIN=changeme
# Localhost RCON only. No spaces, at least 3 characters.
RCON_PASSWORD=changeme
